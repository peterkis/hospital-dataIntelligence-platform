{
  "name": "@hospital-data-intelligence/verification-tooling",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "report:abg-coverage": "tsx src/report-abg-coverage.ts --write",
    "test": "vitest run",
    "test:adversarial": "vitest run src/testing/adversarial-verification.test.ts",
    "test:lifecycle": "vitest run src/runtime src/evidence/recorder.test.ts",
    "test:provenance": "vitest run src/provenance src/review-formal-abg-evidence.test.ts src/testing/build-valid-evidence-fixture.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "verify:phase-01:preflight": "node src/runtime/formal-preflight.ts",
    "verify:phase-01:teardown": "node src/runtime/formal-teardown.ts",
    "verify:source-manifest": "tsx src/provenance/verify-current-source-manifest.ts",
    "verify:abg-coverage": "tsx src/report-abg-coverage.ts --check"
  },
  "dependencies": {
    "@hospital-data-intelligence/generated-api-client": "0.0.0",
    "pg": "8.22.0"
  }
}
