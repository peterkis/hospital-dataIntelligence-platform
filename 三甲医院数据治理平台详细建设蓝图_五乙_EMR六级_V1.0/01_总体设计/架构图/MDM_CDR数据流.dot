digraph G { graph [rankdir=LR,bgcolor="white",pad="0.2",nodesep="0.25",ranksep="0.4",fontname="Noto Sans CJK SC"]; node [shape=box,style="rounded,filled",fontname="Noto Sans CJK SC",fontsize=10,color="#315B7D",fillcolor="#EAF2F8"]; edge [fontname="Noto Sans CJK SC",fontsize=9,color="#567A96"];
