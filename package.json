{
  "name": "hospital-data-intelligence-platform",
  "version": "0.0.0",
  "private": true,
  "description": "Phase 01 executable architecture baseline for hospital foundational-data governance.",
  "packageManager": "npm@11.9.0",
  "engines": {
    "node": "24.18.0",
    "npm": "11.9.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*",
    "tests/*",
    "tooling/*"
  ],
  "scripts": {
    "prototype:person:assignment:baseline": "node --env-file-if-exists=.env.prototype.local tooling/prototype/person-assignment-preservation.mjs baseline",
    "prototype:person:assignment:preservation": "node --env-file-if-exists=.env.prototype.local tooling/prototype/person-assignment-preservation.mjs verify",
    "prototype:person:assignment:types": "npm run db:types:generate --workspace @hospital-data-intelligence/governance-api",
    "prototype:person:assignment:application": "node --env-file-if-exists=.env.prototype.local --import tsx tooling/prototype/person-assignment-application-probe.ts",
    "prototype:person:assignment:recover": "node --env-file-if-exists=.env.prototype.local --import tsx tooling/prototype/person-assignment-application-probe.ts --recover",
    "prototype:person:assignment:constraints": "node --env-file-if-exists=.env.prototype.local --import tsx tooling/prototype/person-assignment-application-probe.ts --constraints-only",
    "prototype:person:assignment:recover-negative": "node --env-file-if-exists=.env.prototype.local tooling/prototype/person-assignment-recover-negative.mjs",
    "prototype:person:assignment:fresh-install": "node --env-file-if-exists=.env.prototype.local tooling/prototype/person-assignment-fresh-install.mjs",
    "prototype:person:assignment:access": "node --env-file-if-exists=.env.prototype.local --import tsx tooling/prototype/person-assignment-application-probe.ts --access-only",
    "prototype:person:assignment:regressions": "node tooling/prototype/person-assignment-regressions.mjs",
    "prototype:person:assignment:gates": "node tooling/prototype/person-assignment-regressions.mjs --gates-only",
    "prototype:person:assignment:catalog": "node --env-file-if-exists=.env.prototype.local tooling/prototype/person-assignment-catalog.mjs",
    "prototype:person:assignment:freeze": "node --import tsx tooling/prototype/person-assignment-freeze.ts",
    "prototype:person:assignment:concurrency": "node --env-file-if-exists=.env.prototype.local --import tsx tooling/prototype/person-assignment-application-probe.ts --concurrency-only",
    "prototype:person:assignment:period": "node --env-file-if-exists=.env.prototype.local --import tsx tooling/prototype/person-assignment-application-probe.ts --period-only",
    "prototype:person:engagement-temporal:recover-negative": "node tooling/prototype/person-engagement-temporal-recover-negative.mjs",
    "prototype:person:engagement-temporal:regressions": "node tooling/prototype/person-engagement-temporal-regressions.mjs",
    "prototype:person:engagement-temporal:validate": "npm run prototype:person:engagement-temporal:application && npm run prototype:person:engagement-temporal:regressions",
    "prototype:person:engagement-temporal:application": "node --env-file-if-exists=.env.prototype.local --import tsx tooling/prototype/person-engagement-temporal-application-probe.ts",
    "prototype:person:engagement-temporal:recover": "node --env-file-if-exists=.env.prototype.local --import tsx tooling/prototype/person-engagement-temporal-application-probe.ts --recover",
    "prototype:person:engagement-temporal:fresh-install": "node --env-file-if-exists=.env.prototype.local tooling/prototype/person-engagement-temporal-fresh-install.mjs",
    "prototype:person:engagement-temporal:baseline": "node --env-file-if-exists=.env.prototype.local --import tsx tooling/prototype/person-engagement-temporal-baseline-probe.ts",
    "prototype:person:engagement-lifecycle:constraints": "node --env-file-if-exists=.env.prototype.local --import tsx tooling/prototype/person-engagement-lifecycle-constraint-probe.ts",
    "prototype:person:engagement-lifecycle:application": "node --env-file-if-exists=.env.prototype.local --import tsx tooling/prototype/person-engagement-lifecycle-application-probe.ts",
    "prototype:person:engagement-lifecycle:recover": "node --env-file-if-exists=.env.prototype.local --import tsx tooling/prototype/person-engagement-lifecycle-application-probe.ts --recover",
    "prototype:person:engagement-lifecycle:validate": "npm run prototype:person:engagement-lifecycle:constraints && npm run prototype:person:engagement-lifecycle:application",
    "prototype:person:engagement-policy:constraints": "node --env-file-if-exists=.env.prototype.local --import tsx tooling/prototype/person-engagement-policy-constraint-probe.ts",
    "prototype:person:engagement-policy:application": "node --env-file-if-exists=.env.prototype.local --import tsx tooling/prototype/person-engagement-policy-application-probe.ts",
    "prototype:person:engagement-overlap:application": "node --env-file-if-exists=.env.prototype.local --import tsx tooling/prototype/person-engagement-overlap-application-probe.ts",
    "prototype:person:engagement-classification:recover": "node --env-file-if-exists=.env.prototype.local --import tsx tooling/prototype/person-engagement-overlap-application-probe.ts --recover",
    "prototype:person:engagement-classification:validate": "npm run prototype:person:engagement-policy:constraints && npm run prototype:person:engagement-policy:application && npm run prototype:person:engagement-overlap:application",
    "prototype:person:engagement:constraints": "node --env-file-if-exists=.env.prototype.local --import tsx tooling/prototype/person-engagement-constraint-probe.ts",
    "prototype:person:engagement:application": "node --env-file-if-exists=.env.prototype.local --import tsx tooling/prototype/person-engagement-application-probe.ts",
    "prototype:person:engagement:validate": "npm run prototype:person:engagement:constraints && npm run prototype:person:engagement:application",
    "prototype:person:source-mapping:constraints": "node --env-file-if-exists=.env.prototype.local --import tsx tooling/prototype/person-source-mapping-constraint-probe.ts",
    "prototype:person:source-mapping:application": "node --env-file-if-exists=.env.prototype.local --import tsx tooling/prototype/person-source-mapping-application-probe.ts",
    "prototype:person:source-mapping:validate": "npm run prototype:person:source-mapping:constraints && npm run prototype:person:source-mapping:application",
    "prototype:person:identifier:constraints": "node --env-file-if-exists=.env.prototype.local --import tsx tooling/prototype/person-identifier-constraint-probe.ts",
    "prototype:person:identifier:application": "node --env-file-if-exists=.env.prototype.local --import tsx tooling/prototype/person-identifier-application-probe.ts",
    "prototype:person:identifier:validate": "npm run prototype:person:identifier:constraints && npm run prototype:person:identifier:application",
    "prototype:person:constraints": "node --env-file-if-exists=.env.prototype.local --import tsx tooling/prototype/person-subject-constraint-probe.ts",
    "prototype:person:application": "node --env-file-if-exists=.env.prototype.local --import tsx tooling/prototype/person-subject-application-probe.ts",
    "prototype:person:validate": "npm run prototype:person:constraints && npm run prototype:person:application",
    "prototype:consumer:metrics:validate": "node --env-file-if-exists=.env.prototype.local --import tsx tooling/prototype/validate-department-consumer-flow.ts --metrics",
    "contract:check-consumer-audit": "node --import tsx apps/governance-api/scripts/check-consumer-audit-openapi-diff.ts",
    "prototype:consumer:audit:validate": "node --env-file-if-exists=.env.prototype.local --import tsx tooling/prototype/validate-department-consumer-flow.ts --audit",
    "consumer:replay": "node --import tsx tooling/prototype/consumer-replay.ts",
    "test:consumer-replay": "node --import tsx --test tooling/prototype/consumer-replay.test.ts",
    "check:runtime": "node tooling/verification/src/check-runtime.mjs",
    "check:repo:layout": "node tooling/verification/src/check-repo-layout.mjs",
    "check:module-boundaries": "node tooling/verification/src/check-module-boundaries.ts",
    "check:database-authority": "node tooling/verification/src/check-database-authority.ts",
    "verify:phase-01:live": "node tooling/verification/src/verify-phase-01-live.ts",
    "verify:phase-01:formal": "node --loader ./tooling/verification/node-ts-loader.mjs tooling/verification/src/run-formal-abg.ts",
    "verify:phase-01:preflight": "npm run verify:phase-01:preflight --workspace @hospital-data-intelligence/verification-tooling --",
    "verify:phase-01:teardown": "npm run verify:phase-01:teardown --workspace @hospital-data-intelligence/verification-tooling --",
    "verify:phase-01:evidence": "tsx tooling/verification/src/review-formal-abg-evidence.ts",
    "rebaseline:ar-12": "tsx tooling/verification/src/rebaseline/ar-12-orchestrator.ts execute-in-workspace",
    "rebaseline:ar-12:recovery": "tsx tooling/verification/src/rebaseline/ar-12-orchestrator.ts",
    "verify:ar12-history-evidence-contract": "npm run verify:ar12-history-evidence-contract --workspace @hospital-data-intelligence/verification-tooling",
    "verify:verification-source-manifest": "npm run verify:source-manifest --workspace @hospital-data-intelligence/verification-tooling -- ../..",
    "verify:abg-coverage": "npm run verify:abg-coverage --workspace @hospital-data-intelligence/verification-tooling",
    "check": "npm run check:runtime && npm run check:repo:layout && npm run check:module-boundaries && npm run contract:check-projection-freeze && npm run contract:check-consumer-sdk && npm run contract:check-consumer-audit && npm run check:database-authority",
    "typecheck": "tsc -p tooling/prototype/tsconfig.json --noEmit && npm run typecheck --workspaces --if-present",
    "build": "npm run build --workspace @hospital-data-intelligence/generated-api-client && npm run build --workspace @hospital-data-intelligence/release-consumer-sdk && npm run build --workspace @hospital-data-intelligence/admin-web && npm run build --workspace @hospital-data-intelligence/governance-api && npm run build --workspace @hospital-data-intelligence/sim-consumer",
    "contract:generate": "npm run contract:generate --workspace @hospital-data-intelligence/governance-api",
    "contract:generate-client": "npm run contract:generate --workspace @hospital-data-intelligence/generated-api-client",
    "contract:lint": "redocly lint contracts/openapi/phase-01.openapi.json --extends=minimal --skip-rule=operation-2xx-response",
    "contract:check-projection-freeze": "node --import tsx --test tooling/prototype/department-projection-freeze.test.ts",
    "test:e2e": "node tests/e2e/run-playwright.ts",
    "test:e2e:list": "node tests/e2e/run-playwright.ts --list",
    "test:verification": "npm run test --workspace @hospital-data-intelligence/verification-tooling",
    "test:verification:ar12-composer": "npm run test:ar12-composer --workspace @hospital-data-intelligence/verification-tooling",
    "test:verification:ar12-history-contract": "npm run test:ar12-history-contract --workspace @hospital-data-intelligence/verification-tooling",
    "test:verification:adversarial": "npm run test:adversarial --workspace @hospital-data-intelligence/verification-tooling",
    "test:verification:lifecycle": "npm run test:lifecycle --workspace @hospital-data-intelligence/verification-tooling",
    "test:verification:podman-runtime": "npm run test:podman-runtime --workspace @hospital-data-intelligence/verification-tooling",
    "test:verification:provenance": "npm run test:provenance --workspace @hospital-data-intelligence/verification-tooling",
    "verify:podman-runtime-authority": "npm run verify:podman-runtime-authority --workspace @hospital-data-intelligence/verification-tooling",
    "prototype:db:check": "node --env-file-if-exists=.env.prototype.local tooling/prototype/check-database.mjs",
    "prototype:db:with": "node tooling/prototype/run-with-database.mjs",
    "prototype:db:migrate": "node --env-file-if-exists=.env.prototype.local tooling/runtime/apply-migrations.mjs db/migrations",
    "prototype:db:seed": "tsx --env-file-if-exists=.env.prototype.local tooling/prototype/seed-prototype.ts",
    "prototype:department:seed": "tsx --env-file-if-exists=.env.prototype.local tooling/prototype/seed-department-demo.ts",
    "prototype:department:constraints": "tsx --env-file-if-exists=.env.prototype.local tooling/prototype/department-constraint-probe.ts",
    "prototype:department:repository": "tsx --env-file-if-exists=.env.prototype.local tooling/prototype/department-repository-probe.ts",
    "prototype:department:projection": "tsx --env-file-if-exists=.env.prototype.local tooling/prototype/department-projection-probe.ts",
    "prototype:department:application": "tsx --env-file-if-exists=.env.prototype.local tooling/prototype/department-application-probe.ts",
    "prototype:department:validate": "npm run prototype:department:constraints && npm run prototype:department:repository && npm run prototype:department:projection && npm run prototype:department:application",
    "prototype:smoke": "tsx --env-file-if-exists=.env.prototype.local tooling/prototype/run-core-flow.ts",
    "prototype:validate": "npm run prototype:db:check && npm run prototype:db:migrate && npm run prototype:db:seed && npm run prototype:department:seed && npm run prototype:department:validate && npm run prototype:smoke",
    "prototype:api:start": "node --env-file-if-exists=.env.prototype.local --import tsx apps/governance-api/src/prototype-main.ts",
    "prototype:http:smoke": "node --env-file-if-exists=.env.prototype.local --import tsx tooling/prototype/run-http-flow.ts",
    "prototype:http:validate": "tsx --env-file-if-exists=.env.prototype.local tooling/prototype/validate-http-flow.ts",
    "prototype:department:http:smoke": "node --env-file-if-exists=.env.prototype.local --import tsx tooling/prototype/run-department-http-flow.ts",
    "prototype:department:http:validate": "tsx --env-file-if-exists=.env.prototype.local tooling/prototype/validate-http-flow.ts department",
    "prototype:department:consumer:validate": "tsx --env-file-if-exists=.env.prototype.local tooling/prototype/validate-department-consumer-flow.ts",
    "prototype:ui:build": "npm run build:prototype --workspace @hospital-data-intelligence/admin-web",
    "prototype:ui:start": "node --env-file-if-exists=.env.prototype.local --import tsx tooling/prototype/start-ui.ts",
    "prototype:ui:validate": "node --env-file-if-exists=.env.prototype.local --import tsx tooling/prototype/validate-ui.ts",
    "prototype:demo:prepare": "npm run prototype:db:check && npm run prototype:db:migrate && npm run prototype:db:seed && tsx --env-file-if-exists=.env.prototype.local tooling/prototype/demo-reset.ts",
    "prototype:demo": "node --env-file-if-exists=.env.prototype.local --import tsx tooling/prototype/start-ui.ts --demo",
    "test": "node tooling/test/run-root-tests.mjs",
    "contract:check-consumer-sdk": "npm run contract:check --workspace @hospital-data-intelligence/release-consumer-sdk",
    "prototype:department:consumer:sdk:validate": "tsx --env-file-if-exists=.env.prototype.local tooling/prototype/validate-department-consumer-flow.ts --sdk"
  },
  "devDependencies": {
    "@redocly/cli": "2.46.0",
    "@types/node": "24.13.3",
    "@vitest/coverage-v8": "4.1.6",
    "tsx": "4.23.11",
    "typescript": "7.0.2",
    "vitest": "4.1.6"
  },
  "overrides": {
    "glob": "10.5.0",
    "js-yaml": "4.3.1"
  }
}
