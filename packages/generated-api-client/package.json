{
  "name": "@hospital-data-intelligence/generated-api-client",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "contract:generate": "npm exec --yes --package=openapi-typescript@7.13.0 -- openapi-typescript ../../contracts/openapi/phase-01.openapi.json -o src/schema.generated.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "openapi-fetch": "0.17.0"
  }
}
