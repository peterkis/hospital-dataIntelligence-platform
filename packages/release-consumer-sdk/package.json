{
  "name": "@hospital-data-intelligence/release-consumer-sdk",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "contract:generate": "node scripts/generate-contracts.mjs",
    "contract:check": "node scripts/generate-contracts.mjs --check && node scripts/check-package.mjs"
  },
  "dependencies": {
    "@hospital-data-intelligence/generated-api-client": "0.0.0",
    "json-canonicalize": "2.0.0",
    "typebox": "1.3.11"
  }
}
